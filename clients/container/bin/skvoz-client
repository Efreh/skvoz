#!/usr/bin/env ruby
# frozen_string_literal: true
Warning[:experimental] = false
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
require 'bundler/setup'
require_relative '../lib/skvoz/client'
begin
  Skvoz::Client::Bootstrap.run(ARGV.dup)
rescue StandardError => error
  code = error.is_a?(Skvoz::Client::Error) && error.message.match?(/\A[a-z_]{1,64}\z/) ? error.message : 'client_failed'
  warn JSON.generate(component: 'client', stage: 'failed', code: code)
  exit 1
end
